{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "vitest/globals",
            "node"
        ],
        "baseUrl": "..",
        "paths": {
            "@shared/*": [
                "shared/*"
            ],
            "@server/*": [
                "server/*"
            ]
        }
    },
    "include": [
        "./**/*.ts",
        "../server/**/*.ts",
        "../shared/**/*.ts"
    ]
}