# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oddjob
DB_USER=postgres
DB_PASSWORD=your_database_password

# Authentication Configuration
AUTH_SECRET=your_auth_secret_key_change_in_production
AUTH_PROVIDER=jwt  # Options: jwt, oauth, session

# Blueprint Execution Service
BLUEPRINT_BASE_URL=http://localhost:3000/api/blueprints
BLUEPRINT_API_KEY=your_blueprint_api_key

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Rate Limiting (for production with Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OAuth Configuration (if using OAuth provider)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Logging
LOG_LEVEL=info  # Options: debug, info, warn, error
