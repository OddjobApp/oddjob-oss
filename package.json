{
  "name": "oddjob",
  "version": "1.0.0",
  "description": "Agentic studio: missions, App Forge, GMS/Evolution, Hermes tracing, RAG memory, JIT MCP.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "jsonValidation": [
    {
      "fileMatch": [
        "**/job-config.json"
      ],
      "url": "./server/config/jobs/job-config.schema.json"
    }
  ],
  "scripts": {
    "clean": "rimraf dist node_modules/typescript/tsbuildinfo",
    "clean:logs": "node scripts/clean-logs.mjs",
    "dev:compile": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --project tsconfig.server.json",
    "dev:fix-imports": "node scripts/fix-imports.js",
    "dev:build": "npm run clean && npm run dev:compile && npm run dev:fix-imports && node dist/server/index.js",
    "predev": "node scripts/kill-dev.mjs",
    "dev": "concurrently -n server,worker,sidecar -c blue,magenta,green \"npm run dev:server\" \"npm run start:worker\" \"npm run backend\"",
    "dev:no-sidecar": "concurrently -n server,worker -c blue,magenta \"npm run dev:server\" \"npm run start:worker\"",
    "dev:server": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "dev:robust": "node scripts/robust-dev.mjs",
    "docs:executors": "tsx scripts/generate-executor-docs.ts",
    "docs:sync": "tsx scripts/sync-documentation.ts",
    "knowledge-packs:install-demo-finance": "tsx scripts/install-synthetic-finance-pack.ts",
    "audit:ui-tokens": "tsx scripts/audit-ui-tokens.ts",
    "audit:deps": "npm audit --audit-level=high",
    "lint:theme": "node scripts/check-theme-surfaces.mjs",
    "lint:z-index": "node scripts/check-z-index-scale.mjs",
    "lint:dialogs": "node scripts/check-native-dialogs.mjs",
    "lint:arch": "tsx scripts/lint-architecture.ts",
    "lint:org-scoping": "tsx scripts/lint-org-scoping.ts",
    "e2e:index": "tsx scripts/index-e2e-tests.ts",
    "e2e:author:seed": "tsx scripts/author-seed-ui-contract.ts",
    "build": "npm run docs:executors && npm run gen:executor-manifest && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build && esbuild server/index.ts server/worker-entrypoint.ts server/mcp/index.ts server/migrate.ts server/setup.ts server/scripts/switch-primary-model.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "gen:executor-manifest": "node scripts/generate-executor-manifest.mjs",
    "check:executor-manifest": "node scripts/generate-executor-manifest.mjs --check",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:worker": "tsx server/worker-entrypoint.ts",
    "start:workers": "cross-env NODE_ENV=production node dist/worker-entrypoint.js",
    "check": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc",
    "build:packages": "npm run build --workspace=@oddjob/design-system",
    "verify:formal": "vitest run server/domain/scaffold/formal/tests/ server/domain/mission/tests/mission-schedulability-prover.test.ts server/domain/governance/tests/formal-governance.test.ts server/domain/scaffold/tests/sat-scaffold-resolver.test.ts",
    "verify": "npm run check:migration-journal && npm run check:executor-manifest && npm run check:tool-idempotency && npm run lint:theme && npm run lint:z-index && npm run lint:dialogs && npm run lint:arch && npm run lint:org-scoping && npm run lint:shared-ai-keys && npm run check:domain-drift && npm run check:declared-deps && npm run build:packages && npm run check && npm run test && npm run smoke && npm run build",
    "verify:full": "npm run audit:deps && npm run verify",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "setup": "tsx server/setup.ts",
    "db:switch-model": "tsx server/scripts/switch-primary-model.ts",
    "db:baseline": "node scripts/baseline-existing-database.mjs",
    "capabilities:sync-product": "tsx scripts/sync-product-capabilities.ts",
    "db:seed": "tsx server/seed.ts",
    "test:signal-loop": "vitest run server/domain/signal-intelligence/tests/integration/surprise-replan-loop.test.ts",
    "test:drift": "vitest run client/src/lib/tutorial-drift.test.ts",
    "check:migration-journal": "tsx scripts/check-migration-journal.ts",
    "check:tool-idempotency": "tsx scripts/check-tool-idempotency.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:schema-drift:update": "tsx scripts/check-schema-drift.ts --update-baseline",
    "check:domain-drift": "tsx scripts/check-domain-drift.ts",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "test:e2e:signals": "playwright test --config=playwright.signals.config.ts",
    "test:e2e:signals:headed": "cross-env HEADED=true playwright test --config=playwright.signals.config.ts",
    "secrets:list": "tsx scripts/list-required-secrets.ts",
    "rag:seed": "tsx scripts/data/seed-qdrant.ts",
    "knowledge:backfill-index": "tsx scripts/backfill-unindexed-knowledge-documents.ts",
    "memory:backfill-index": "tsx scripts/backfill-long-term-memory-index.ts",
    "knowledge:backfill-xray-specs": "tsx scripts/backfill-xray-specs-to-knowledge.ts",
    "test:regression": "tsx scripts/tests/regression-tests.ts",
    "test:evals": "tsx tests/evals/eval_runner.ts",
    "evals:gate": "tsx scripts/evals/gate.ts",
    "evals:memory": "tsx scripts/evals/memory-recall-eval.ts",
    "evals:ci": "tsx scripts/evals/ci.ts",
    "component-index:sync": "tsx server/scripts/sync-component-index.ts",
    "graph:index": "tsx scripts/index-system-graph.ts",
    "components:verify": "tsx server/scripts/verify-components.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude '**/integration/**' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --coverage --exclude '**/integration/**' --exclude '**/*.integration.test.{ts,tsx}'",
    "smoke:spatial-stream": "tsx --import dotenv/config scripts/smoke/validate-spatial-stream.ts",
    "smoke:capabilities": "tsx scripts/smoke/validate-product-capability-manifest.ts",
    "smoke:autonomy-policy": "tsx scripts/smoke/validate-autonomy-policy.ts",
    "smoke:evo-devo-db": "tsx scripts/smoke/evo-devo-db-smoke.ts",
    "smoke:golden-path": "tsx scripts/smoke/run-golden-path-contract.ts",
    "demo:golden-path": "tsx scripts/demo/run-golden-path-demo.ts",
    "smoke:golden-path:fixture": "tsx scripts/smoke/validate-golden-path-fixture.ts",
    "smoke:golden-path:research": "tsx scripts/smoke/validate-golden-path-research-fixture.ts",
    "smoke": "npm run smoke:capabilities && npm run smoke:autonomy-policy && npm run smoke:golden-path && npm run smoke:golden-path:fixture && npm run smoke:golden-path:research",
    "smoke:db": "npm run smoke:spatial-stream && npm run smoke:evo-devo-db",
    "import:jira": "tsx scripts/import-jira.ts",
    "mcp": "npm run dev:compile && npm run dev:fix-imports && node dist/server/mcp/index.js",
    "mcp:dev": "tsx server/mcp/index.ts",
    "mcp:http": "tsx server/mcp/http-server.ts",
    "start:mcp": "cross-env NODE_ENV=production node dist/mcp/index.js",
    "mcp:http:build": "npm run dev:compile && npm run dev:fix-imports && node dist/server/mcp/http-server.js",
    "playwright:install": "npx playwright install --with-deps chromium",
    "test:demos": "cross-env RUN_DEMOS=true HEADED=true npx playwright test",
    "seed:rescue-e2e": "tsx server/scripts/seed-rescue-dispatch-e2e-data.ts",
    "test:db:admin": "tsx server/scripts/ensure-test-admin.ts",
    "agents:fallbacks": "tsx server/scripts/backfill-agent-fallbacks.ts",
    "agents:fallbacks:check": "tsx server/scripts/backfill-agent-fallbacks.ts --check",
    "install:ingestor": "cd services/ingestor && npm install",
    "install:consumer": "cd services/consumer && pip install -r requirements.txt",
    "install:services": "npm run install:ingestor && npm run install:consumer",
    "ingestor": "cd services/ingestor && npm run dev",
    "consumer": "cd services/consumer && python -u main.py",
    "backend": "cd backend && .venv\\Scripts\\python -u main.py",
    "auth": "npm run dev --workspace=@oddjob/auth-service",
    "dev:services": "concurrently \"npm run ingestor\" \"npm run consumer\" \"npm run backend\" \"npm run auth\"",
    "backup": "tsx scripts/backup-db.ts",
    "cli": "ts-node scripts/cli/index.ts",
    "dev:client": "npm run dev --workspace=client",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "lint:shared-ai-keys": "tsx scripts/lint-shared-ai-keys.ts",
    "encryption:rotate": "tsx scripts/rotate-encryption-key.ts",
    "check:declared-deps": "tsx scripts/check-declared-deps.ts"
  },
