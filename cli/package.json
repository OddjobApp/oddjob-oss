{
    "name": "@oddjob/cli",
    "version": "1.0.0",
    "description": "Command-line interface for Oddjob workflow automation platform",
    "main": "dist/index.js",
    "bin": {
        "oddjob": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "ts-node index.ts",
        "watch": "tsc --watch",
        "test": "jest",
        "lint": "eslint . --ext .ts",
