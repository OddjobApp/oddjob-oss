{
  "name": "@oddjob/design-system",
  "version": "0.1.0",
  "description": "Unified design system for Oddjob UI - colors, icons, tokens, and component guidelines",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.js",
      "types": "./dist/tokens.d.ts"
    },
    "./icons": {
      "import": "./dist/icons.js",
      "require": "./dist/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "lucide-react": "^0.394.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
