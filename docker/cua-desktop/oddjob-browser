#!/bin/sh
# The desktop's browser. One Chromium instance per desktop, with remote debugging on
# 127.0.0.1:9222 so Oddjob can record and replay skills. A second call with the same
# profile hands its URL to the running instance (a new tab) and exits.
#
# --no-sandbox: Chromium's sandbox needs user namespaces, which Docker's default seccomp
# profile blocks. The container is the isolation boundary: one per organization, on a
# network where desktops cannot reach each other.
PROFILE="${HOME:-/home/cua}/.config/oddjob-chromium"
mkdir -p "$PROFILE"
exec /usr/bin/chromium \
    --user-data-dir="$PROFILE" \
    --remote-debugging-port=9222 \
    --remote-debugging-address=127.0.0.1 \
    --no-first-run \
    --no-default-browser-check \
    --disable-dev-shm-usage \
    --no-sandbox \
    --password-store=basic \
    --start-maximized \
    "$@"
