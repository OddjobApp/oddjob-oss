FROM node:22-slim
WORKDIR /app

# Install basic toolchain
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Pre-cache common Oddjob dependencies
# This is a generic package.json that covers 90% of industrial apps
COPY package.json .
COPY package-lock.json* ./

RUN npm install --frozen-lockfile --legacy-peer-deps || npm install --legacy-peer-deps

# Default Next.js port
EXPOSE 3000

ENV NODE_ENV=development
ENV CHOKIDAR_USEPOLLING=true

# Keep the container alive with a wait loop if no app is mounted yet
CMD ["sh", "-c", "if [ -f package.json ]; then npm run dev; else tail -f /dev/null; fi"]
