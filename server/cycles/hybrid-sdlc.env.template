# ==========================================
# ODDJOB HYBRID SDLC - SECRETS TEMPLATE
# ==========================================
# Instructions: Copy this file to `.env` or inject these into your Production Secrets Manager (AWS/Vercel)
# before running the Org Forge `installCycleApp()` engine.

# --- AI Provider Configuration ---
AI_API_KEY="your_anthropic_api_key_here"

# --- Global Tech Stack Preferences ---
TECH_BACKEND_LANG="TypeScript"
TECH_FRONTEND_FRAMEWORK="React"
TECH_MOBILE_FRAMEWORK="React Native"

# --- Source Control Integration (Required) ---
# Supported providers: github, gitlab, bitbucket
GIT_PROVIDER="github"
GIT_REPO_URL="https://github.com/your-org/your-repo"
GIT_API_TOKEN="your_git_personal_access_token"

# --- Database Integration (Target Application) ---
DB_DIALECT="postgres"
DEV_DATABASE_URL="postgresql://dev_user:dev_pass@localhost:5432/dev_db"
STAGING_DATABASE_URL="postgresql://staging_user:staging_pass@staging-db-host:5432/staging_db"
REDIS_URL="redis://localhost:6379"
MONGODB_URL="mongodb://localhost:27017/dev_db"
VECTOR_DB_URL="https://your-qdrant-instance.com"
VECTOR_DB_API_KEY="your_vector_db_api_key_here"

# --- Package Registry (Enterprise Private NPM) ---
NPM_REGISTRY_URL="https://npm.pkg.github.com"
NPM_AUTH_TOKEN="your_npm_read_token"

# --- Jira Integration ---
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_PROJECT_KEY="ODD"
JIRA_API_TOKEN="your_jira_personal_access_token_here"

# --- Confluence Integration ---
CONFLUENCE_BASE_URL="https://your-org.atlassian.net/wiki"
CONFLUENCE_ENG_SPACE="ENG"
CONFLUENCE_API_TOKEN="your_confluence_api_token_here"

# --- SharePoint Integration (Alternative to Confluence) ---
SHAREPOINT_TENANT_ID="your_sharepoint_tenant_id"
SHAREPOINT_SITE_ID="your_sharepoint_site_id"
SHAREPOINT_DRIVE_ID="your_sharepoint_drive_id"

# --- Google Drive Integration (Alternative to Confluence) ---
GOOGLE_SHARED_DRIVE_ID="your_google_shared_drive_id"
GOOGLE_DOCS_FOLDER_ID="your_google_folder_id"
GOOGLE_SERVICE_ACCOUNT_JSON="path/to/service-account.json"

# --- Google Calendar & Meet Integration ---
GOOGLE_CALENDAR_ID="your_google_calendar_id"

# --- GCP Integration (Deployment Target) ---
GCP_PROJECT_ID="your_gcp_project_id"
GCP_REGION="us-central1"

# --- Slack Integration ---
SLACK_WORKSPACE_ID="T12345678"
SLACK_ALERTS_CHANNEL="#sdlc-alerts"
SLACK_APPROVALS_CHANNEL="#engineering"
SLACK_DEFAULT_CHANNEL="#sdlc-updates"
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# --- Observability & Monitoring ---
METRICS_ENDPOINT="https://metrics.your-org.com"
TRACING_ENDPOINT="https://tracing.your-org.com"

# --- Human Role Assignments ---
PRODUCT_OWNER_USER_ID="user_product_owner_1"
TECH_LEAD_USER_ID="user_tech_lead_1"
QA_LEAD_USER_ID="user_qa_lead_1"
DEVOPS_LEAD_USER_ID="user_devops_lead_1"
SECURITY_LEAD_USER_ID="user_security_lead_1"

# --- App Workbench Configurations ---
# PM Workbench
PM_WORKBENCH_NOTIFICATION_CHANNEL="#product-updates"
PM_WORKBENCH_REQUIREMENT_QUALITY_THRESHOLD="0.7"
PM_WORKBENCH_VELOCITY_PREDICTION_WINDOW_DAYS="90"

# Scrum Master Workbench
SCRUM_MASTER_WORKBENCH_SPRINT_LENGTH_DAYS="14"
SCRUM_MASTER_WORKBENCH_VELOCITY_ANOMALY_THRESHOLD="0.3"
SCRUM_MASTER_WORKBENCH_BLOCKER_SLA_HOURS="4"

# QA Workbench
QA_WORKBENCH_COVERAGE_THRESHOLD="80"
QA_WORKBENCH_FLAKY_TEST_THRESHOLD="3"
QA_WORKBENCH_CRITICAL_PATH_COVERAGE="0.8"

# Stakeholder Workbench
STAKEHOLDER_WORKBENCH_DIGEST_FREQUENCY_HOURS="4"
STAKEHOLDER_WORKBENCH_ROI_CALCULATION_WINDOW_DAYS="30"
STAKEHOLDER_WORKBENCH_APPROVAL_SLA_HOURS="24"

# AI Workforce Dashboard
AI_WORKFORCE_DASHBOARD_SUCCESS_RATE_THRESHOLD="0.85"
AI_WORKFORCE_DASHBOARD_TOKEN_BUDGET_ALERT_PERCENT="80"
AI_WORKFORCE_DASHBOARD_PIP_IMPROVEMENT_WINDOW_DAYS="14"

# --- AgentMail Integration ---
AGENTMAIL_ADMIN_ADDRESS="cto@your-org.com"
AGENTMAIL_DOMAIN="agents.your-org.com"

# --- Webhook Tunneling (Local Development Only) ---
NGROK_AUTH_TOKEN="your_ngrok_auth_token_here"
NGROK_STATIC_DOMAIN="your-custom-domain.ngrok-free.app"

# --- Security & Compliance ---
AUDIT_LOGGING_ENABLED="true"
ENCRYPTION_ENABLED="true"
MFA_REQUIRED_FOR_CRITICAL="true"
SESSION_TIMEOUT_MINUTES="60"
DATA_RESIDENCY_ENABLED="false"
CONSENT_MANAGEMENT_ENABLED="false"
RIGHT_TO_BE_FORGOTTEN_ENABLED="false"
BREACH_NOTIFICATION_ENABLED="false"
PHI_ENCRYPTION_ENABLED="false"
MINIMUM_NECESSARY_ACCESS_ENABLED="true"
SECURITY_POLICY_ENABLED="true"
RISK_MANAGEMENT_ENABLED="true"
ASSET_MANAGEMENT_ENABLED="true"
ACCESS_CONTROL_ENABLED="true"
BUSINESS_CONTINUITY_ENABLED="true"
MSTEAMS_TEAM_ID="your_msteams_team_id"
MSTEAMS_ALERTS_WEBHOOK="https://your-org.webhook.office.com/..."
MSTEAMS_APPROVALS_WEBHOOK="https://your-org.webhook.office.com/..."
