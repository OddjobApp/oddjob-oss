# Oddjob environment
# Copy to .env. The Node server and the Python sidecar (backend/) both read this file.
# server/config/env.ts is the authority for the Node server: it validates these at
# boot and logs every capability a missing value switches off.

# =============================================================================
# Required to start
# =============================================================================

# Postgres and Redis from `docker compose up -d db redis` (Postgres is published on 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oddjob
REDIS_URL=redis://localhost:6379

# Required in production; the boot fails without it. Signs session cookies, and
# server/utils/auth-context.ts also accepts it as INTERNAL_API_SECRET, which
# grants the caller an arbitrary organizationId — so this is a tenant boundary,
# not just a cookie key. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required in production. Encrypts stored integration credentials and org AI keys.
# APP_TOKEN_ENCRYPTION_KEY is accepted as an alias. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Signs and verifies external API tokens (server/domain/auth/core/token-service.ts).
# docker-compose.yml refuses to start any service without it. openssl rand -hex 32
JWT_SECRET=

# AI is bring-your-own-key: each organization stores its own provider key under
# Settings. In development this key is the fallback; production refuses to boot
# with any shared provider key set. GOOGLE_API_KEY is accepted as an alias.
# See docs/developer-guides/KEYS_AND_CREDENTIALS.md.
GEMINI_API_KEY=

# Leave PORT unset: the Node server defaults to 5000 and the Python sidecar to 8000,
# and both read PORT, so setting it here moves both onto the same port.
# PORT=

# =============================================================================
# Optional services — each one switches on a capability
# =============================================================================

# Vector search (RAG retrieval, knowledge similarity). Without it those return nothing.
#   docker compose up -d qdrant
# QDRANT_URL=http://localhost:6333

# Kafka event backbone (disabled by default; Redis remains the local fallback)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=oddjob-api
KAFKA_GROUP_ID=oddjob-spatial
KAFKA_SPATIAL_GROUP_ID=oddjob-spatial-v1
KAFKA_OUTBOX_POLL_MS=500
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_JOIN_TIMEOUT_MS=45000
KAFKA_REQUIRED=false
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# AgentMail: agents send and receive email. Both values are needed; without either
# AgentMail stays off.
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=your-inbox@agentmail.to
# AGENTMAIL_WEBHOOK_SECRET=

# Computer use: agents drive a desktop VM (screenshots + mouse/keyboard).
# Unset = mock provider (fake screenshots, no VM). For a local Linux desktop:
#   docker compose --profile computer-use up -d   (watch at http://127.0.0.1:6901)
# then set TRYCUA_PROVIDER=cua and TRYCUA_PROVIDER_TYPE=local and restart the server.
# TRYCUA_PROVIDER_TYPE=org_desktop instead gives every org its own desktop container,
# created on its first session and stopped after TRYCUA_DESKTOP_IDLE_MINUTES (default 30);
# needs the docker CLI on the server's PATH. Limits: TRYCUA_DESKTOP_MEMORY_MB (2048),
# TRYCUA_DESKTOP_CPUS (1).
# TRYCUA_PROVIDER_TYPE=cloud instead needs CUA_API_KEY + CUA_SANDBOX_NAME from cua.ai.
TRYCUA_PROVIDER=
TRYCUA_PROVIDER_TYPE=
# host:port of the VM's control API; matches TRYCUA_LOCAL_PORT in docker-compose.yml
TRYCUA_LOCAL_HOST=127.0.0.1:8010
# Desktop image: oddjob/cua-desktop (Cua XFCE + a recordable Chromium) builds itself from
# docker/cua-desktop on first use. Learned skills (record a takeover, approve, replay) need
# TRYCUA_PROVIDER_TYPE=org_desktop. Set TRYCUA_SKILLS_AUTOMATCH=false to replay only skills
# a task names explicitly (skillId) instead of matching approved skills to every goal.
# TRYCUA_SKILLS_AUTOMATCH=true
# Model that plans autonomous computer-use runs (Gemini Interactions API, GEMINI_API_KEY).
# gemini-2.5-computer-use-preview-10-2025 also works (browser environment only).
TRYCUA_CU_MODEL=gemini-3.8-flash
# The Cua SDK reports usage events to PostHog unless this is false.
CUA_TELEMETRY_ENABLED=false

# Optional audit-report server attestation. If unset, reports are explicitly marked unsigned.
AUDIT_REPORT_SIGNING_SECRET=
AUDIT_REPORT_SIGNING_KEY_ID=oddjob-audit-report-v1

# =============================================================================
# Node server tuning
# =============================================================================

# Session idle timeout (server-enforced)
# A session with no requests for this many minutes stops being authenticated:
# the next request is treated as signed-out and the client is sent to /auth/login.
# The session COOKIE remains a 30-day absolute cap; this is the inactivity cap.
# An invalid value falls back to the 20-minute default rather than disabling.
SESSION_IDLE_TIMEOUT_MINUTES=20
# Set to false only where long-lived unattended sessions are genuinely wanted.
SESSION_IDLE_TIMEOUT_ENABLED=true

# Internal RPC (pod-to-pod communication)
# MUST be overridden in production — server refuses to start with the default
INTERNAL_RPC_KEY=change-me-in-production

# App Forge (workbench app builds)
# Build forge/workbench apps OUTSIDE any cloud-synced folder (OneDrive/Dropbox/etc.).
# Building inside a synced tree breaks Next.js symlink creation with EPERM
# ("symlink ... import-in-the-middle -> .next/dev/node_modules/..."), so builds fail
# and workbench apps never go healthy. Point this at a plain local, writable path.
# (Defaults to C:\LocalData\forge\workspace on Windows / ./storage/forge-workspace elsewhere.)
# FORGE_WORKSPACE=C:/Users/<you>/AppData/Local/oddjob-forge

# Distributed Tracing (OpenTelemetry)
# Set OTEL_ENABLED=true to send traces to a local Jaeger/Tempo instance
OTEL_ENABLED=false
OTEL_SERVICE_NAME=oddjob-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Graph-backed Playwright UI behavior contracts
# Disabled by default: enabling permits the worker to assemble only low-risk,
# high-confidence generated tests after two passing validation runs.
E2E_AUTO_AUTHOR_ENABLED=false

# Capability documentation synchronization (ACDD)
# All automatic triggers and Git mutation remain disabled by default.
# Set this to an existing organization before enabling either trigger.
ACDD_SYNC_ORG_ID=
ACDD_SYNC_TOOLS_ON_BOOT=false
ACDD_SYNC_PIPELINES=false
ACDD_WATCH_DOCS=false

# Capability docs and semantic discovery
ACDD_DOCS_REPO_PATH=
ACDD_DOCS_SUBDIR=docs/capabilities
# Leave UNSET. Capability vectors are sharded per embedding contract as
# acdd_capabilities__<provider>__<model>, because dimensionality is a property of the
# model — gemini-embedding-001 is 3072-wide while the older 768-wide collections are
# not searchable with it. Pinning one name collapses every model into a single
# collection and the first query from a differently-sized model fails. Set this only to
# point at a pre-existing collection you know matches the configured model.
ACDD_QDRANT_COLLECTION=
ACDD_DISCOVER_TOP_K=3
ACDD_DISCOVER_SCORE_THRESHOLD=

# Git-backed documentation versioning
ACDD_GIT_AUTO_COMMIT=false
ACDD_GIT_AUTO_PUSH=false
ACDD_DOCS_MANAGE_BRANCHES=false
ACDD_GIT_DOCS_BRANCH=
ACDD_GIT_REMOTE=origin
ACDD_GIT_AUTHOR_NAME=ACDD Bot
ACDD_GIT_AUTHOR_EMAIL=acdd-bot@oddjob.local

# Dedicated checkout for managed-branch mode: none | worktree | clone
ACDD_DOCS_CHECKOUT_MODE=none
ACDD_DOCS_CHECKOUT_SOURCE=
ACDD_DOCS_CHECKOUT_BRANCH=main

# =============================================================================
# Python sidecar (backend/) — only when you run it (npm run dev, or npm run backend)
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
# HOST=0.0.0.0
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_PDF_SIZE_MB=50
PDF_PROCESSING_TIMEOUT=300
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10
USER_AGENT=Oddjob-Dev/1.0

# =============================================================================
# Compose deployment files only (docker-compose.yml / .prod.yml / .staging.yml)
# =============================================================================
# Node's SMTP configuration lives in System Settings; these feed the compose files.
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERT_WEBHOOK_URL=
# GRAFANA_ADMIN_PASSWORD=
