{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "@shared/*": ["shared/*"],
      "@domain/*": ["server/domain/*"],
      "@domain-ui/*": ["server/domain/*"],
      "@server/*": ["server/*"],
      "@oddjob/shared-utils/*": ["packages/shared-utils/src/*"],
      "@oddjob/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@assets/*": ["attached_assets/*"]
    }
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["node_modules", "server"]
}
