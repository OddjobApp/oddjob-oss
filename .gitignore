# Logs
logs/
/diagnostics/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
storage/
# ...but `storage/` above matches any directory of that name at any depth, which
# was silently excluding real source. Keep the domain's storage pod tracked.
!server/domain/**/storage/
*.local

# Environment variables - DO NOT COMMIT SECRETS
.env
.env.local
.env.*.local
.env.bak
.env*.bak
.env.production
.env.staging
.env.development.local
.env.test

# Scratch / diagnostic scripts (may contain hardcoded credentials)
scratch/
tmp/

# Credential and secret dumps
connectors_dump.json
*-dump.json
*credentials*.json
*-secrets.json
*_secrets.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Kubernetes secrets (sensitive even as templates)
k8s/**/secrets.yaml
k8s/**/secret.yaml
k8s/**/*-secret.yaml

# Database files
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

logs/
scripts/temp/
.venv/
*.log
*.log.*
*.txt
!README.md
!components.json
!package.json
!package-lock.json
!tsconfig*.json
!*.config.ts
!*.config.js
!*.spec.ts
!*.setup.ts
!Dockerfile
!docker-compose*.yml
!index.html
!postcss.config.js
!tailwind.config.ts
!vite.config.ts
!vitest.config.ts
!*.swcrc
!*.replit
!node-fetch.d.ts
!REFACTORING_ANALYSIS.md
!FORM_AGENT_FEATURE_DOCUMENTATION.md
!attached_assets/
!backend/
!client/
!docs/
!k8s/
# (k8s/**/secrets.yaml is excluded above — that rule takes precedence)
!nginx/
!packages/
!scripts/
!server/
!services/
!shared/
!uploads/

# Local blob store. blob-storage.ts defaults its root here, so anything the
# attachment service writes at runtime — Scribe publications included — lands
# in this directory as content-hashed files. Runtime data, not source.
uploads/attachments/

# Agent planning artifacts
.agent/
agent_debug_service.log
temp_training/
# Fine-tuned model adapters (weights) at the repository root only; an unanchored
# "adapters/" also hid the LLM adapter sources in server/domain/ai/adapters/.
/adapters/

# Local configuration with credentials
.claude/settings.local.json
playwright/.auth/

# Auto-generated files with non-deterministic content (random values on every run)
docs/SYSTEM_ARCHITECTURE.md

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Forge/blueprint build outputs & caches (never commit — huge, machine-specific)
**/.next/
storage/prewarm-pool/
storage/forge-workspace/
storage/forge-prewarm/

# Generated eval results (regenerated per run; not source)
tests/evals/.last-results.json

# Playwright test-repo runtime artifacts — auth state holds session cookies (secrets);
# reports/results/node_modules are generated per run and must never be committed.
playwright-test-repo/playwright/.auth/
playwright-test-repo/playwright-report/
playwright-test-repo/test-results/

# Playwright output at the repo root. Regenerated on every run and previously
# committed — ~2,000 lines of churn per commit, plus a .last-run.json recording a
# red suite as though it were source.
/playwright-report/
/test-results/
playwright-test-repo/node_modules/

# Throwaway debug/trigger scripts (not source) — root-level scratch-*.ts recur here
/scratch-*.ts
/temp-commit-source/

# Runtime screenshot & test artifacts
# Anchored to the repo root: a bare `.artifacts/` would also ignore any nested
# directory of that name, which is how `diagnostics/` once silently swallowed
# server/domain/diagnostics.
/.artifacts/
*.png
rescue-dispatch-*.png
tmp-*.png
debug-overlay.png
test-failed-*.png

# TSC and build log dumps
tsc_output_*.txt
tsc-errors*.log
tsc_errors*.log
vitest_output.log
.codex-root-server.*.log


# never commit env backups
.env.bak*

# Ad-hoc temp verification scripts (Playwright, etc.) — never commit
_*_tmp.mjs

# Generated by scripts/rebuild-domain-map.js. Nothing reads it, it stores
# absolute machine-local paths, and it churned ~9.4k lines per regeneration.
server/domain/domain_files.json

# Root-level scratch that was committed before the rules above existed. The
# files were untracked with `git rm --cached` (they remain on disk); these
# entries stop them coming back. `tmp/` and `*.png` were already ignored — the
# 108 tmp/ files and 10 root screenshots predated those rules, and .gitignore
# does not untrack what is already tracked.
/tmp-watch.ts
/query.cjs
/failure_log.json
/cookies.txt

# Credential scratch. tmp/ is ignored, but be explicit: nothing matching this
# belongs in the index under any path.
**/ai_credentials.json

# vitest coverage output
coverage/

# More root-level scratch, same reasoning as the block above. `_*.ts` are the
# throwaway tsx probes a debugging session leaves behind (they import server
# services directly and hardcode one org's ids); `2.6.0` is pip's console output
# caught by a stray redirect; start_comfyui.bat is one machine's WSL2 launcher.
/_*.ts
/2.6.0
/start_comfyui.bat

# Session write-ups an agent left at the root. Documentation belongs under docs/.
/character-removal-implementation.md
/comprehensive-media-studio-test-suite.md
/media-studio-playwright-test-report.md

# Agent scratch directory: run logs, screenshots and one-off probes a session
# writes while working. Anchored, because `tmp/` above does not match `.tmp/`.
/.tmp/

# Any env variant (backups included) can hold live secrets; only templates are tracked.
.env.*
!.env.example

# One-off Google Workspace demo script; its output holds real mailbox data.
google-workspace-demo.ts
google-workspace-demo-results.json

# Maven build output of blueprint apps
server/blueprints/apps/*/target/

# Local agent scratch files: never commit
.gemini_scratch/
